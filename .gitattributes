/assets/brand/manifest.json text eol=lf
/assets/brand/source/*.svg text eol=lf
/assets/brand/generated/manifest-lock.json text eol=lf
/tools/brand-assets/** text eol=lf

# Canonical localization sources and deterministic generated outputs are
# byte-checked on Windows and macOS; never let autocrlf alter their hashes.
/browser/shared-ui/locales/** text eol=lf
/browser/shared-ui/localization/generated/** text eol=lf
/tools/locales/** text eol=lf

/assets/brand/**/*.png binary
/assets/brand/**/*.ico binary
/assets/brand/**/*.icns binary

# Frozen contract goldens are compared byte-exact by tests; CRLF conversion
# on Windows checkouts (core.autocrlf=true) would break them.
/crates/**/tests/*.txt text eol=lf
/crates/crayon-content-markdown/tests/golden/** text eol=lf

# Vendored KaTeX text assets are byte-locked by the MRT-07 manifest and
# embedded during CMake configure. Keep checkout bytes identical to Git blobs.
/third_party/katex/LICENSE text eol=lf
/third_party/katex/assets/katex.mjs text eol=lf
/third_party/katex/assets/katex.min.css text eol=lf

# Mermaid's 104-file runtime closure is likewise byte-locked and contains
# only JavaScript modules.
/third_party/mermaid/assets/** text eol=lf
