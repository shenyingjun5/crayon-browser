#ifndef CRAYON_BROWSER_SHARED_UI_NEW_TAB_GENERATED_LOCALIZED_STRINGS_H_
#define CRAYON_BROWSER_SHARED_UI_NEW_TAB_GENERATED_LOCALIZED_STRINGS_H_

#include "crayon/new_tab/new_tab.h"

namespace crayon::browser::new_tab {

inline NewTabStrings EnglishNewTabStrings() {
  return {"en",
          "@CRAYON_EN_title@",
          "@CRAYON_EN_search_placeholder@",
          "@CRAYON_EN_shortcuts_heading@",
          "@CRAYON_EN_private_heading@",
          "@CRAYON_EN_private_description@",
          "@CRAYON_EN_cast_label@"};
}

inline NewTabStrings ChineseNewTabStrings() {
  return {"zh-CN",
          "@CRAYON_ZH_title@",
          "@CRAYON_ZH_search_placeholder@",
          "@CRAYON_ZH_shortcuts_heading@",
          "@CRAYON_ZH_private_heading@",
          "@CRAYON_ZH_private_description@",
          "@CRAYON_ZH_cast_label@"};
}

}  // namespace crayon::browser::new_tab

#endif  // CRAYON_BROWSER_SHARED_UI_NEW_TAB_GENERATED_LOCALIZED_STRINGS_H_
