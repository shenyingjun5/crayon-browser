// MDV-16: compile-time embedded Mermaid Full runtime closure. Generated by
// CMake from third_party/mermaid/manifest.json; every asset's bytes are
// verified against the manifest at configure time.
#pragma once

#include <cstddef>

#include "crayon/browser_markdown_runtime/runtime_assets.h"

namespace crayon::browser_markdown_runtime::internal {

struct EmbeddedMermaidAsset {
  const char* resource_id;
  const unsigned char* bytes;
  std::size_t size;
};

@MERMAID_ASSET_DECLARATIONS@

inline constexpr EmbeddedMermaidAsset kEmbeddedMermaidAssets[] = {
@MERMAID_ASSET_ROWS@};

inline constexpr std::size_t kEmbeddedMermaidAssetCount =
    sizeof(kEmbeddedMermaidAssets) / sizeof(kEmbeddedMermaidAssets[0]);

}  // namespace crayon::browser_markdown_runtime::internal
