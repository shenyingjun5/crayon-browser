{
  "schemaVersion": "browser-design-v1",
  "theme": "light",
  "viewport": "wide",
  "deviceScaleFactor": 1,
  "logical": {
    "widthDip": 1280,
    "tabStripHeightDip": 40,
    "navigationBarHeightDip": 48,
    "shellHeightDip": 88,
    "iconCanvasDip": 24,
    "glyphDip": 20,
    "minimumHitTargetDip": 32,
    "focusRingDip": 2
  },
  "physical": {
    "widthPx": 1280,
    "shellHeightPx": 88,
    "iconCanvasPx": 24,
    "glyphPx": 20,
    "minimumHitTargetPx": 32,
    "focusRingPx": 2
  },
  "colors": {
    "toolbarBackground": "#FFFFFF",
    "tabStripBackground": "#E8EEF8",
    "activeTabBackground": "#FFFFFF",
    "inactiveTabForeground": "#475467",
    "foreground": "#1D2939",
    "mutedForeground": "#667085",
    "hoverBackground": "#E7ECF5",
    "pressedBackground": "#D8E1F0",
    "focusRing": "#2F6FED",
    "separator": "#D0D5DD",
    "brandAction": "#2F6FED",
    "success": "#168568",
