{
  "schemaVersion": "browser-design-v1",
  "units": "dip",
  "informationArchitecture": {
    "rows": [
      "tab-strip",
      "navigation-bar"
    ],
    "tabStripOrder": [
      "app.window-identity",
      "tabs",
      "tab.new",
      "tab.search",
      "window.controls"
    ],
    "navigationOrder": [
      "nav.back",
      "nav.forward",
      "nav.reload-stop",
      "nav.home",
      "omnibox",
      "bookmark.outline",
      "download.open",
      "cast.device",
      "profile.open",
      "menu.more"
    ]
  },
  "viewports": {
    "narrow": {
      "widthDip": 720
    },
    "wide": {
      "widthDip": 1280
    }
  },
  "breakpoints": {
    "wideMinWidthDip": 800
  },
  "scales": [
    1,
    2
  ],
  "metrics": {
    "tabStripHeightDip": 40,
    "navigationBarHeightDip": 48,
    "shellHeightDip": 88,
    "iconCanvasDip": 24,
    "glyphDip": 20,
    "minimumHitTargetDip": 32,
    "preferredHitTargetDip": 36,
    "focusRingDip": 2,
    "controlGapDip": 4,
    "groupGapDip": 8,
    "cornerRadiusDip": 8,
    "pillRadiusDip": 18,
    "tabMinWidthDip": 96,
    "tabMaxWidthDip": 240,
    "omniboxMinWidthDip": 160
  },
  "layouts": {
    "narrow": {
      "visibleControls": [
        "nav.back",
        "nav.forward",
        "nav.reload-stop",
        "omnibox",
        "cast.device",
        "menu.more"
      ],
      "overflowControls": [
        "nav.home",
        "bookmark.outline",
        "download.open",
        "profile.open"
      ]
    },
    "wide": {
      "visibleControls": [
        "nav.back",
        "nav.forward",
        "nav.reload-stop",
        "nav.home",
        "omnibox",
        "bookmark.outline",
        "download.open",
        "cast.device",
        "profile.open",
        "menu.more"
      ],
      "overflowControls": []
    }
  },
  "states": {
    "button": [
      "rest",
      "hover",
      "pressed",
      "focus-visible",
      "disabled"
    ],
    "tab": [
      "inactive",
      "hover",
      "active",
      "attention",
      "dragging"
    ],
    "omnibox": [
      "rest",
      "hover",
      "focused",
      "editing",
      "invalid"
    ],
    "cast": [
      "unavailable",
      "eligible",
      "selecting",
      "casting",
      "error"
    ]
  },
  "themes": {
    "light": {
      "colors": {
        "toolbarBackground": "#FFFFFF",
        "tabStripBackground": "#E8EEF8",
        "activeTabBackground": "#FFFFFF",
        "inactiveTabForeground": "#475467",
        "foreground": "#1D2939",
        "mutedForeground": "#667085",
        "hoverBackground": "#E7ECF5",
        "pressedBackground": "#D8E1F0",
        "focusRing": "#2F6FED",
        "separator": "#D0D5DD",
        "brandAction": "#2F6FED",
        "success": "#168568",
        "warning": "#B54708",
        "error": "#D92D20"
      }
    },
    "dark": {
      "colors": {
        "toolbarBackground": "#20242C",
        "tabStripBackground": "#171A20",
        "activeTabBackground": "#20242C",
        "inactiveTabForeground": "#98A2B3",
        "foreground": "#F2F4F7",
        "mutedForeground": "#AAB2C0",
        "hoverBackground": "#303744",
        "pressedBackground": "#3B4555",
        "focusRing": "#78A6FF",
        "separator": "#475467",
        "brandAction": "#78A6FF",
        "success": "#47CD89",
        "warning": "#FDB022",
        "error": "#F97066"
      }
    }
  }
}
